# PowerDNS Authoritative Server configuration
# Rendered by entrypoint from environment variables. Do not edit directly.
# Defaults for all variables are set in entrypoint.sh.

launch=$PDNS_LAUNCH

# PostgreSQL backend
gpgsql-host=$PDNS_GPGSQL_HOST
gpgsql-port=$PDNS_GPGSQL_PORT
gpgsql-dbname=$PDNS_GPGSQL_DBNAME
gpgsql-user=$PDNS_GPGSQL_USER
gpgsql-password=$PDNS_GPGSQL_PASSWORD
gpgsql-extra-connection-parameters=connect_timeout=5
gpgsql-prepared-statements=$PDNS_GPGSQL_PREPARED_STATEMENTS

# Listen on internal port — recursor owns port 53 externally
local-address=$PDNS_LOCAL_ADDRESS
local-port=$PDNS_LOCAL_PORT

# Role
primary=yes
secondary=no

# Web server / API
webserver=yes
webserver-address=$PDNS_WEBSERVER_ADDRESS
webserver-port=$PDNS_WEBSERVER_PORT
webserver-allow-from=$PDNS_WEBSERVER_ALLOW_FROM
webserver-password=$PDNS_WEBSERVER_PASSWORD
webserver-max-bodysize=8
api=yes
api-key=$PDNS_API_KEY

# Zone transfer
disable-axfr=no
allow-axfr-ips=$PDNS_ALLOW_AXFR_IPS
allow-notify-from=$PDNS_ALLOW_NOTIFY_FROM

# Caches
cache-ttl=$PDNS_CACHE_TTL
negquery-cache-ttl=$PDNS_NEGQUERY_CACHE_TTL
query-cache-ttl=$PDNS_QUERY_CACHE_TTL

# Logging
loglevel=$PDNS_LOGLEVEL
log-dns-queries=$PDNS_LOG_DNS_QUERIES
log-dns-details=no
logging-facility=0

# Process management (supervisord manages the process)
guardian=no
daemon=no
