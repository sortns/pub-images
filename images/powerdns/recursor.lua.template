-- PowerDNS Recursor Lua configuration
-- Rendered by entrypoint from environment variables. Do not edit directly.

-- RPZ: served by the authoritative server (zones stored in database, not local files)
rpzPrimary(
  {"$PDNS_RECURSOR_RPZ_PRIMARY"},
  "$PDNS_RECURSOR_RPZ_ZONE_NAME",
  {refresh=$PDNS_RECURSOR_RPZ_REFRESH}
)

-- NTA file: generated by pdns-sync-forward-zones from the auth server API.
-- Adds Negative Trust Anchors so DNSSEC validation is bypassed for internal forwarded zones.
local ntaFile = "$PDNS_RECURSOR_NTA_LUA_FILE"
local fh = io.open(ntaFile, "r")
if fh ~= nil then
  fh:close()
  dofile(ntaFile)
end
